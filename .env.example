# ─────────────────────────────────────────────────────────────────────────────
# VoiceShield — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env with actual credentials to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── ASR Provider Configuration ────────────────────────────────────────────────
# Active Speech-to-Text provider:
#   whisper -> Local offline CPU inference using faster-whisper (default)
#   google  -> Real-time streaming cloud ASR via Google Cloud Speech-to-Text
ASR_PROVIDER=google

# Language code for speech recognition:
# Supported by Google STT: en-IN, en-US, hi-IN, ta-IN, te-IN, kn-IN, ml-IN
ASR_LANGUAGE=en-IN

# ── Google Cloud Authentication ───────────────────────────────────────────────
# For local testing, authenticate with Application Default Credentials (ADC):
#   gcloud auth application-default login
# Alternatively, specify the path to your service account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Audio & Pipeline Knobs ────────────────────────────────────────────────────
TARGET_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
STREAMING_CHUNK_DURATION_MS=1000
STREAMING_FAST_ALERT_THRESHOLD=0.85
STREAMING_SMOOTHING_ALPHA=0.4
SPEAKER_SIMILARITY_THRESHOLD=0.70

# ── Database & Server ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./voiceshield.db
LOG_LEVEL=INFO
