# ─────────────────────────────────────────────────────────────────────────────
# VoiceShield — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env with actual credentials to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Speech-to-Text (Google Cloud STT) ─────────────────────────────────────────
# VoiceShield uses Google Cloud Speech-to-Text (streaming gRPC) as its primary ASR engine.
# Language code for speech recognition:
# Supported: en-IN, en-US, hi-IN, ta-IN, te-IN, kn-IN, ml-IN, etc.
ASR_LANGUAGE=en-IN

# ── Google Cloud Authentication ───────────────────────────────────────────────
# For local testing, authenticate with Application Default Credentials (ADC):
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or use a Google Cloud API Key directly:
# GOOGLE_API_KEY=your_google_cloud_api_key

# ── Audio & Pipeline Knobs ────────────────────────────────────────────────────
TARGET_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
STREAMING_CHUNK_DURATION_MS=1000
STREAMING_FAST_ALERT_THRESHOLD=0.85
STREAMING_SMOOTHING_ALPHA=0.4
SPEAKER_SIMILARITY_THRESHOLD=0.70

# ── Database & Server ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./voiceshield.db
LOG_LEVEL=INFO
